@model StudentRegister_BTT3.Models.Student

<div class="container mt-5">

    <div class="card shadow p-4">

        <h2 class="text-center text-primary mb-4">
            ĐĂNG KÝ CHUYÊN NGÀNH
        </h2>

        <form asp-action="ShowKQ" method="post">

            <div class="mb-3">
                <label class="form-label">MSSV</label>
                <input asp-for="MSSV" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Họ tên</label>
                <input asp-for="HoTen" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Điểm trung bình</label>
                <input asp-for="DiemTB" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Chuyên ngành</label>

                <select asp-for="ChuyenNganh" class="form-select">

                    <option value="CNPM">CNPM</option>
                    <option value="HTTT">HTTT</option>
                    <option value="ANM">ANM</option>
                    <option value="TTNT">TTNT</option>
                    <option value="MMT">MMT</option>

                </select>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-success px-4">
                    Đăng ký
                </button>
            </div>

        </form>

    </div>

</div>